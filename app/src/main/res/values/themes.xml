<resources>
    <!-- Base application theme. -->
    <style name="Theme.SmartAttendance" parent="android:Theme.Material.Light.NoActionBar">
        <!--
            We leave system bar colors to the enableEdgeToEdge() API
            which is called in MainActivity.
        -->
    </style>

    <!-- Splash Screen theme. -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="postSplashScreenTheme">@style/Theme.SmartAttendance</item>
    </style>
</resources>
